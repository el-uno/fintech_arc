{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Arc",
  "description": "Arc is a simulation of cross-border stablecoin and fiat infrastructure for the EU↔Africa corridor — and a field guide to how stablecoin payments actually work.",
  "colors": {
    "primary": "#14B8A6",
    "light": "#2DD4BF",
    "dark": "#0F766E"
