  "appearance": {
    "default": "dark"
  },
  "favicon": "/logo/mark.svg",
  "logo": {
    "light": "/logo/arc-light.svg",
    "dark": "/logo/arc-dark.svg",
    "href": "/"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "styling": {
    "codeblocks": "dark",
    "eyebrows": "breadcrumbs"
  },
